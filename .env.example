# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

# LLM provider for chat (theme discovery, classification, composition).
# Embeddings are computed locally with scikit-learn TF-IDF + SVD (no key needed).
LLM_PROVIDER=groq
LLM_API_KEY=gsk_your_groq_api_key_here

# Recipient of the weekly pulse email (self or an alias). One plain address, no "Name <addr>".
# publish.email_mode in config/config.yaml decides draft (default) vs send.
PULSE_RECIPIENT=me@example.com

# MCP server (Google Docs + Gmail). URL lives in config/mcp_servers.yaml.
# Bearer token for /mcp, at least 32 characters. Keep it out of git.
MCP_AUTH_TOKEN=
# Optional: reuse an existing Google Doc (ID or docs.google.com/document/d/<id> URL).
# Leave blank to let the first publish create the Doc and remember its ID in data/state/.
PULSE_DOC_ID=
# Optional: override the server URL from config/mcp_servers.yaml.
# MCP_SERVER_URL=https://mcpserver-production-da04.up.railway.app/mcp

# Optional overrides (defaults shown)
# PULSE_CONFIG_PATH=config/config.yaml
# PULSE_MCP_CONFIG_PATH=config/mcp_servers.yaml
# PULSE_DATA_DIR=data
# PULSE_LOG_LEVEL=INFO
